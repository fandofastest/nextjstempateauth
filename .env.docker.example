# Core
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# App URLs
NEXTAUTH_URL=https://your-domain
NEXTAUTH_SECRET=change-me

NEXT_PUBLIC_API_URL=https://your-domain/api

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=360d

# MongoDB (internal compose service)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin
MONGO_DBNAME=appdb
MONGODB_URI=mongodb://admin:admin@mongo:27017/appdb?authSource=admin

# Admin bootstrap
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Upload limits
NEXT_PUBLIC_UPLOAD_MAX_SIZE_MB=1024
UPLOAD_MAX_SIZE_MB=1024

# Upload paths
UPLOAD_DIR=/data/uploads
UPLOADS_HOST_DIR=./uploads

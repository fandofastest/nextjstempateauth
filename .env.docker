# Core
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# App URLs
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-super-secret
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# JWT
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=360d

# MongoDB (matches docker-compose mongo service)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin
MONGO_DBNAME=appdb
MONGODB_URI=mongodb://admin:admin@mongo:27017/appdb?authSource=admin

# Admin bootstrap (optional)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=Admin123!
ADMIN_PHONE=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=1070208909902-f1p8f3r52j8jnc1qk0sktft2h4bslism.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Upload limits
NEXT_PUBLIC_UPLOAD_MAX_SIZE_MB=1024
UPLOAD_MAX_SIZE_MB=1024
 
# Upload paths
# Container path where the app writes uploads
UPLOAD_DIR=/data/uploads
# Host path you want to store files (outside Docker). Can be absolute or relative to project root.
# On Windows, you may use something like: C:\\data\\uploads
UPLOADS_HOST_DIR=./uploads
